# Application environment
# development | test | production
NODE_ENV=development

# PostgreSQL connection (required)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genstore

# Authentication secret (required)
# Use either NEXTAUTH_SECRET (legacy NextAuth naming) or AUTH_SECRET (Auth.js v5).
# Must be at least 32 characters.
NEXTAUTH_SECRET=change-me-to-a-random-string-with-at-least-32-characters
# AUTH_SECRET=change-me-to-a-random-string-with-at-least-32-characters

# JWT secret for custom auth (required)
# Must be at least 32 characters.
JWT_SECRET=change-me-to-another-random-string-with-at-least-32-characters

# Midtrans payment gateway
# Sandbox keys start with SB-Mid-server-.../SB-Mid-client-...; production keys with Mid-server-.../Mid-client-...
# MIDTRANS_SERVER_KEY=your-midtrans-server-key
# MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# MIDTRANS_IS_PRODUCTION=false
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Fonnte WhatsApp gateway (placeholder)
# FONNTE_TOKEN=your-fonnte-token

# Resend email service (placeholder)
# RESEND_API_KEY=your-resend-api-key
# NOTIFY_FROM_EMAIL=no-reply@gensaberilmustore.com

# Cron secret for /api/cron/retry-notifications (placeholder)
# CRON_SECRET=your-cron-secret

# File storage: product/avatar/misc images
# STORAGE_PROVIDER=local (default, writes to public/uploads) or STORAGE_PROVIDER=r2 (Cloudflare R2)
# When STORAGE_PROVIDER=r2, all of the R2_* variables below are required.
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-bucket-name
# Public base URL for the bucket (r2.dev subdomain or a custom domain with a public bucket binding)
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Sentry error monitoring (placeholder)
# SENTRY_DSN=your-sentry-dsn
