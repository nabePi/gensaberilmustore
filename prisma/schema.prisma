generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  AFFILIATE
  ADMIN
}

enum CoverType {
  SOFTCOVER
  HARDCOVER
  EBOOK
}

enum RibbonType {
  NEW
  BEST
  DISCOUNT
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PACKED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  EWALLET
  QRIS
  POS_CASH
  POS_TRANSFER
  POS_QRIS
}

enum OrderSource {
  ONLINE
  POS
}

enum AffiliateConversionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AffiliatePayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum KidsSectionTheme {
  CREAM
  MINT
  CORAL
  YELLOW
  LAVENDER
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationTemplate {
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  ORDER_PACKED
  ORDER_SHIPPED
  ORDER_COMPLETED
  PASSWORD_RESET
  AFFILIATE_JOIN
  AFFILIATE_PAYOUT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum VoucherType {
  PERCENT
  FIXED
}

enum VoucherChannel {
  ALL
  ONLINE
  POS
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  passwordmd5     String?
  name            String?
  phone           String?
  whatsappNumber  String?
  avatarUrl       String?
  role            Role      @default(BUYER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  cart                  Cart?
  receivers             Receiver[]
  orders                Order[]                   @relation("OrderToUser")
  affiliateOrders       Order[]                   @relation("OrderToAffiliateUser")
  posCashierOrders      Order[]                   @relation("OrderToPosCashierUser")
  statusChanges         OrderStatusHistory[]
  affiliateProfile      AffiliateProfile?
  commissionRateUpdates AffiliateCommissionRate[]
  posSessions           POSSession[]
  notifications         Notification[]
  createdVouchers       Voucher[]
  voucherRedemptions    VoucherRedemption[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?
  position Int     @default(0)
  isActive Boolean @default(true)

  parent   Category?         @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryParent")
  products CategoryProduct[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@index([position])
}

model Tag {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  products ProductTag[]

  @@index([slug])
}

model Product {
  id              String      @id @default(uuid())
  sku             String      @unique
  slug            String      @unique
  title           String
  subtitle        String
  author          String
  imprint         String?
  description     String
  tocText         String?
  highlightsText  String?
  price           Int
  discountPercent Int         @default(0)
  finalPrice      Int
  stock           Int         @default(0)
  weightGram      Int
  coverType       CoverType
  pageCount       Int
  publishYear     Int
  isActive        Boolean     @default(true)
  position        Int         @default(0)
  ribbonType      RibbonType?
  ribbonText      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  images                  ProductImage[]
  tags                    ProductTag[]
  categories              CategoryProduct[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  affiliateSelections     AffiliateProductSelection[]
  commissionRate          AffiliateCommissionRate?
  affiliateClicks         AffiliateClick[]
  homepageSectionProducts HomepageSectionProduct[]
  kidsSectionItems        KidsSectionItem[]

  @@index([slug])
  @@index([sku])
  @@index([isActive])
  @@index([position])
  @@index([coverType])
  @@index([ribbonType])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([position])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model CategoryProduct {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Cart {
  id         String   @id @default(uuid())
  userId     String?  @unique
  guestToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([guestToken])
  @@index([updatedAt])
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  productId     String
  quantity      Int
  priceSnapshot Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model City {
  id           String  @id @default(uuid())
  name         String
  province     String
  shippingCost Int
  isActive     Boolean @default(true)

  receivers Receiver[]

  @@index([name])
  @@index([isActive])
}

model Receiver {
  id        String   @id @default(uuid())
  userId    String
  label     String
  name      String
  phone     String
  email     String?
  address   String
  cityId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([userId, isDefault])
  @@index([cityId])
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  userId               String?
  receiverName         String
  receiverPhone        String
  receiverEmail        String?
  receiverAddress      String
  receiverCity         String
  receiverNote         String?
  trackingNumber       String?
  subtotal             Int
  shippingCost         Int
  discount             Int
  total                Int
  paymentMethod        PaymentMethod
  source               OrderSource
  status               OrderStatus   @default(AWAITING_PAYMENT)
  affiliateUserId      String?
  affiliateCode        String?
  posCashierUserId     String?
  posReceiptPrintedAt  DateTime?
  voucherId            String?
  voucherCode          String?
  voucherDiscount      Int           @default(0)
  manualDiscount       Int           @default(0)
  manualDiscountReason String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                User?                @relation("OrderToUser", fields: [userId], references: [id], onDelete: SetNull)
  affiliateUser       User?                @relation("OrderToAffiliateUser", fields: [affiliateUserId], references: [id], onDelete: SetNull)
  posCashierUser      User?                @relation("OrderToPosCashierUser", fields: [posCashierUserId], references: [id], onDelete: SetNull)
  voucher             Voucher?             @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  history             OrderStatusHistory[]
  affiliateConversion AffiliateConversion?
  notifications       Notification[]
  voucherRedemption   VoucherRedemption?
  paymentSession      PaymentSession?

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([posCashierUserId])
  @@index([voucherId])
}

model OrderItem {
  id                      String  @id @default(uuid())
  orderId                 String
  productId               String?
  titleSnapshot           String
  priceSnapshot           Int
  discountPercentSnapshot Int
  quantity                Int
  lineTotal               Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime    @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

model AffiliateProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  code              String   @unique
  payoutBankName    String
  payoutBankAccount String
  payoutBankHolder  String
  isActive          Boolean  @default(true)
  joinedAt          DateTime @default(now())

  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSelections AffiliateProductSelection[]
  clicks            AffiliateClick[]
  conversions       AffiliateConversion[]
  payouts           AffiliatePayout[]

  @@index([code])
}

model AffiliateProductSelection {
  id                 String   @id @default(uuid())
  affiliateProfileId String
  productId          String
  createdAt          DateTime @default(now())

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([affiliateProfileId, productId])
  @@index([affiliateProfileId, createdAt])
  @@index([productId])
}

model AffiliateCommissionRate {
  id              String   @id @default(uuid())
  productId       String   @unique
  percent         Decimal  @db.Decimal(5, 2)
  fixedAmount     Int?
  isActive        Boolean  @default(true)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedByUser User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model AffiliateClick {
  id                 String   @id @default(uuid())
  affiliateProfileId String
  productId          String?
  sourceUrl          String?
  ipAddress          String
  userAgent          String
  cookieId           String
  createdAt          DateTime @default(now())

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([affiliateProfileId, createdAt])
  @@index([productId])
  @@index([cookieId])
}

model AffiliateConversion {
  id                 String                    @id @default(uuid())
  affiliateProfileId String
  orderId            String                    @unique
  commissionAmount   Int
  status             AffiliateConversionStatus @default(PENDING)
  approvedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime                  @default(now())

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateProfileId, createdAt])
  @@index([status])
}

model AffiliatePayout {
  id                 String                @id @default(uuid())
  affiliateProfileId String
  periodStart        DateTime
  periodEnd          DateTime
  totalAmount        Int
  status             AffiliatePayoutStatus @default(PENDING)
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime              @default(now())

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  @@index([affiliateProfileId, createdAt])
  @@index([status])
}

model StoreSetting {
  id                       Int      @id @default(1)
  name                     String
  email                    String
  phone                    String
  address                  String
  defaultShippingCost      Int
  freeShippingMinTotal     Int
  bank1Name                String
  bank1Number              String
  bank1Holder              String
  bank2Name                String
  bank2Number              String
  bank2Holder              String
  defaultCommissionPercent Decimal  @default(5) @db.Decimal(5, 2)
  updatedAt                DateTime @updatedAt
}

enum HomepageBannerSlot {
  HERO_MAIN
  HERO_SIDE_1
  HERO_SIDE_2
}

model HomepageBanner {
  id        String             @id @default(uuid())
  slot      HomepageBannerSlot
  imageUrl  String
  linkUrl   String?
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([slot, position])
}

model HomepageConfig {
  id        Int      @id @default(1)
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id            String   @id @default(uuid())
  key           String   @unique
  title         String
  subtitle      String
  promoImageUrl String
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products HomepageSectionProduct[]

  @@index([position])
}

model HomepageSectionProduct {
  id        String @id @default(uuid())
  sectionId String
  productId String
  position  Int    @default(0)

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@index([productId])
}

model KidsConfig {
  id               Int      @id @default(1)
  heroBadge        String
  heroTitle        String
  heroDescription  String
  heroImageUrl     String
  promoBadge       String
  promoTitle       String
  promoDescription String
  promoImageUrl    String
  updatedAt        DateTime @updatedAt
}

model KidsBanner {
  id        String   @id @default(uuid())
  imageUrl  String
  linkUrl   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model KidsSection {
  id              String           @id @default(uuid())
  title           String
  subtitle        String           @default("")
  badge           String           @default("")
  theme           KidsSectionTheme @default(MINT)
  showDiscountTag Boolean          @default(false)
  position        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items KidsSectionItem[]

  @@index([position])
}

model KidsSectionItem {
  id        String @id @default(uuid())
  sectionId String
  productId String
  position  Int    @default(0)

  section KidsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@index([productId])
}

// Optional: audit trail for POS cashier shifts. Can be dropped if shift
// auditing turns out to be out of scope.
model POSSession {
  id            String    @id @default(uuid())
  cashierUserId String
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openingCash   Int
  closingCash   Int?
  notes         String?

  cashierUser User @relation(fields: [cashierUserId], references: [id], onDelete: Cascade)

  @@index([cashierUserId, openedAt])
}

model Notification {
  id               String               @id @default(uuid())
  channel          NotificationChannel
  recipient        String
  template         NotificationTemplate
  relatedOrderId   String?
  relatedUserId    String?
  payloadJson      Json
  status           NotificationStatus   @default(PENDING)
  providerId       String?
  providerResponse String?
  error            String?
  attempts         Int                  @default(0)
  nextRetryAt      DateTime?
  sentAt           DateTime?
  createdAt        DateTime             @default(now())

  relatedOrder Order? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedUser  User?  @relation(fields: [relatedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
}

model Voucher {
  id              String         @id @default(uuid())
  code            String         @unique
  description     String?
  type            VoucherType
  value           Int
  maxDiscount     Int?
  minPurchase     Int            @default(0)
  channel         VoucherChannel @default(ALL)
  quota           Int?
  usedCount       Int            @default(0)
  perUserLimit    Int?
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean        @default(true)
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdByUser User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  orders        Order[]
  redemptions   VoucherRedemption[]
}

model VoucherRedemption {
  id             String   @id @default(uuid())
  voucherId      String
  orderId        String   @unique
  userId         String?
  discountAmount Int
  createdAt      DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([voucherId, userId])
}

model PaymentSession {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  snapToken             String
  snapRedirectUrl       String
  vaNumber              String?
  lastTransactionStatus String?
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookLog {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String    @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, createdAt])
}

model BlogPost {
  id            String         @id @default(uuid())
  slug          String         @unique
  title         String
  excerpt       String
  contentHtml   String
  coverImageUrl String?
  author        String         @default("Redaksi")
  tags          String[]
  status        BlogPostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
}
